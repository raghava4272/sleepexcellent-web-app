# Server-only Supabase PostgreSQL connection used by Drizzle migrations, seeds, and catalogue reads.
DATABASE_URL=

# Required for the later Supabase Auth and Storage features. Do not put server credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public base URL for the approved public `product-media` Storage bucket.
# Set only after its authoritative objects are uploaded, e.g. .../object/public/product-media
NEXT_PUBLIC_PRODUCT_MEDIA_BASE_URL=
